{
  "manifest_version": 3,
  "name": "MarkDock 书签坞",
  "version": "2.1.1",
  "minimum_chrome_version": "116",
  "description": "极简现代网格书签工作台，提供暗黑与白色双主题、高清站点图标匹配、拖拽整理和失效链接检查。",
  "permissions": [
    "bookmarks",
    "favicon",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "打开 MarkDock 书签坞"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Command+Shift+Y"
      },
      "description": "打开 MarkDock 书签坞"
    },
    "quick-bookmark-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "将当前页面快速保存到书签栏"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "extension-icon-16.png",
    "32": "extension-icon-32.png",
    "48": "extension-icon-48.png",
    "128": "extension-icon-128.png"
  }
}
