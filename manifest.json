{
  "manifest_version": 3,
  "name": "MarkDock 书签坞",
  "version": "2.4.3",
  "minimum_chrome_version": "116",
  "description": "把 Chrome 书签变成一搜即达的工作台：支持拼音/首字母搜索、文件夹整理、重复项清理与 HTML/JSON 备份。完整书签库不上传给开发者。",
  "permissions": [
    "bookmarks",
    "favicon",
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "打开 MarkDock 书签坞",
    "default_icon": {
      "16": "extension-icon-16.png",
      "32": "extension-icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Command+Shift+Y"
      },
      "description": "打开 MarkDock 书签坞"
    },
    "quick-bookmark-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+K"
      },
      "description": "将当前页面快速保存到书签栏"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "extension-icon-16.png",
    "32": "extension-icon-32.png",
    "48": "extension-icon-48.png",
    "128": "extension-icon-128.png"
  }
}
