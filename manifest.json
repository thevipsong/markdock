{
  "manifest_version": 3,
  "name": "MarkDock 书签坞",
  "version": "2.4.1",
  "minimum_chrome_version": "116",
  "description": "管理浏览器书签，支持快速搜索、分类整理、导入导出、双主题外观和按需链接检查。",
  "permissions": [
    "bookmarks",
    "favicon",
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://*.bing.com/*"
  ],
  "action": {
    "default_title": "打开 MarkDock 书签坞",
    "default_icon": {
      "16": "extension-icon-16.png",
      "32": "extension-icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Command+Shift+Y"
      },
      "description": "打开 MarkDock 书签坞"
    },
    "quick-bookmark-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+K"
      },
      "description": "将当前页面快速保存到书签栏"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "extension-icon-16.png",
    "32": "extension-icon-32.png",
    "48": "extension-icon-48.png",
    "128": "extension-icon-128.png"
  }
}
