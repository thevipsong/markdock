{
  "manifest_version": 3,
  "name": "MarkDock 书签坞",
  "version": "2.0.268",
  "minimum_chrome_version": "116",
  "description": "极简现代网格书签工作台，提供暗黑与白色双主题、高清站点图标匹配和失效链接检查。",
  "permissions": [
    "bookmarks",
    "favicon"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "打开 MarkDock"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "extension-icon-16.png",
    "32": "extension-icon-32.png",
    "48": "extension-icon-48.png",
    "128": "extension-icon-128.png"
  }
}
